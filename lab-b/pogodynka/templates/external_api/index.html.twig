{% extends 'base.html.twig' %}

{% block title %}Hello ExternalAPIController!{% endblock %}

{% block body %}
<style>
    .example-wrapper { margin: 1em auto; max-width: 800px; width: 95%; font: 18px/1.5 sans-serif; }
    .example-wrapper code { background: #F5F5F5; padding: 2px 6px; }
</style>

    <div class="example-wrapper">
        <h1>Text Submission Form</h1>
        {{ form_start(form) }}
        {{ form_widget(form) }}
        <button type="submit">Submit</button>
        {{ form_end(form) }}

        {% if weatherData %}
            <h2>Data from Open Meteo</h2>
            <table>
                <thead>
                <tr>
                    <th>Date</th>
                    <th>Max Temperature (*C)</th>
                    <th>Min Temperature (*C)</th>
                    <th>Precipitation (mm)</th>
                </tr>
                </thead>
                <body>
                {% for i in 0..weatherData.daily.time|length-1 %}
                    <tr>
                        <td>{{ weatherData.daily.time[i] }}</td>
                        <td>{{ weatherData.daily.temperature_2m_max[i] }}</td>
                        <td>{{ weatherData.daily.temperature_2m_min[i] }}</td>
                        <td>{{ weatherData.daily.precipitation_sum[i] }}</td>
                    </tr>
                {% endfor %}
                </body>
            </table>
        {% endif %}
    </div>
{% endblock %}
